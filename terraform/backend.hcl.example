# Copy to backend.hcl (git-ignored) and fill in.
# The bucket is created by hand once (not by this configuration), with versioning on.
# Credentials: an OCI "Customer Secret Key", exported as
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
bucket    = "site-analytics-tfstate"
endpoints = { s3 = "https://<namespace>.compat.objectstorage.eu-frankfurt-1.oraclecloud.com" }
